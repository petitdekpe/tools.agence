{% extends 'ticket/layout.html.twig' %}

{% block page_title %}{{ isNew ? (ticket.isPanne ? 'Signaler une panne' : 'Nouvelle demande de matériel') : 'Modifier ' ~ ticket.reference }}{% endblock %}
{% block ticket_actions %}<a class="ghost" href="{{ isNew ? path('app_tickets', {type: ticket.type}) : path('app_ticket_show', {id: ticket.id}) }}">← Retour</a>{% endblock %}

{% block content %}
    <div class="panel form-panel">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.titre) }}
            {{ form_row(form.materiel) }}
            {% if form.categorie is defined %}{{ form_row(form.categorie) }}{% endif %}
            {{ form_row(form.priorite) }}
            {{ form_row(form.description) }}
            {% if form.marquerEnPanne is defined %}{{ form_row(form.marquerEnPanne) }}{% endif %}
            <button class="btn" type="submit">{{ isNew ? (ticket.isPanne ? 'Envoyer le signalement' : 'Envoyer la demande') : 'Enregistrer les modifications' }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
