{% extends 'layout/page.html.twig' %}

{# Outils Personnel et Matériel : onglets entre les deux outils. #}

{% block page_actions %}{% block tool_actions %}{% endblock %}{% endblock %}

{% block tabs %}
    {% set route = app.request.attributes.get('_route') %}
    <nav class="tabs">
        {% if is_granted('personnel.view') %}<a href="{{ path('app_personnel') }}" class="{{ route starts with 'app_personnel' ? 'active' }}">Personnel</a>{% endif %}
        {% if is_granted('materiel.view') %}<a href="{{ path('app_materiel') }}" class="{{ route starts with 'app_materiel' ? 'active' }}">Matériel</a>{% endif %}
    </nav>
{% endblock %}
