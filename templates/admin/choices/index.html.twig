{% extends 'admin/layout.html.twig' %}

{% block page_title %}Listes de choix{% endblock %}

{% block content %}
    <p class="muted">Les listes proposées dans les formulaires (catégories, canaux, priorités...). Ajoutez, renommez, réordonnez ou supprimez leurs valeurs. Renommer une valeur met à jour partout son affichage, sans toucher aux fiches déjà saisies.</p>

    {% for group, lists in groups %}
        <section class="choice-group">
            <h2>{{ group }}</h2>
            <div class="table-card">
                <table class="table">
                    <tbody>
                    {% for l in lists %}
                        <tr>
                            <td>
                                <strong><a href="{{ path('app_admin_choice_list', {list: l.key}) }}">{{ l.title }}</a></strong>
                                <small class="block muted">{{ l.help }}</small>
                            </td>
                            <td class="num"><span class="pill">{{ l.count }} valeur{{ l.count > 1 ? 's' }}</span></td>
                            <td class="right"><a class="ghost" href="{{ path('app_admin_choice_list', {list: l.key}) }}">Gérer</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endfor %}
{% endblock %}
