{% extends 'admin/layout.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
    <section class="kpis">
        <div class="kpi">
            <span class="kpi-label">Utilisateurs</span>
            <strong>{{ totalUsers }}</strong>
            <small>{{ activeUsers }} actif{{ activeUsers > 1 ? 's' }}</small>
        </div>
        <div class="kpi">
            <span class="kpi-label">Corrections</span>
            <strong>{{ totalCorrections }}</strong>
            <small>depuis le début</small>
        </div>
        <div class="kpi">
            <span class="kpi-label">Corrections (7 jours)</span>
            <strong>{{ weekCorrections }}</strong>
            <small>sur la dernière semaine</small>
        </div>
    </section>

    <section class="panels">
        <div class="panel">
            <h2>Répartition par rôle</h2>
            {% for r in byRole %}
                <div class="bar-row">
                    <span>{{ r.label }}</span>
                    <div class="bar"><div class="bar-fill role-{{ r.code|lower|replace({'role_': ''}) }}" style="width: {{ totalUsers ? (r.n / totalUsers * 100)|round : 0 }}%"></div></div>
                    <strong>{{ r.n }}</strong>
                </div>
            {% endfor %}
        </div>

        <div class="panel">
            <h2>Utilisateurs les plus actifs</h2>
            {% for u in topUsers %}
                <div class="line"><div><strong>{{ u.name }}</strong><small>{{ u.email }}</small></div><span class="pill">{{ u.n }} correction{{ u.n > 1 ? 's' }}</span></div>
            {% else %}
                <p class="muted">Aucune correction pour le moment.</p>
            {% endfor %}
        </div>

        <div class="panel">
            <h2>Consommation du correcteur</h2>
            <p class="muted">30 derniers jours. Le cache est la part des tokens d'entrée relue à moindre coût : elle doit être élevée dès que le correcteur sert plusieurs fois par jour.</p>
            {% if usageTotal.n %}
                <div class="line"><div><strong>Toute l'équipe</strong><small>{{ usageTotal.n }} relecture{{ usageTotal.n > 1 ? 's' }} · entrée {{ usageTotal.input|number_format(0, ',', ' ') }} · cache {{ usageTotal.cacheRead|number_format(0, ',', ' ') }} · sortie {{ usageTotal.output|number_format(0, ',', ' ') }}</small></div><span class="pill">{{ usageTotal.cacheShare is null ? '—' : 'cache ' ~ usageTotal.cacheShare ~ ' %' }}</span></div>
                {% for u in usage %}
                    <div class="line"><div><strong>{{ u.name }}</strong><small>{{ u.n }} relecture{{ u.n > 1 ? 's' }} · entrée {{ u.input|number_format(0, ',', ' ') }} · cache {{ u.cacheRead|number_format(0, ',', ' ') }} · sortie {{ u.output|number_format(0, ',', ' ') }}</small></div><span class="pill">{{ u.cacheShare is null ? '—' : 'cache ' ~ u.cacheShare ~ ' %' }}</span></div>
                {% endfor %}
            {% else %}
                <p class="muted">Aucune relecture sur la période.</p>
            {% endif %}
        </div>

        <div class="panel">
            <h2>Dernières connexions</h2>
            {% for u in recentLogins %}
                <div class="line"><div><strong>{{ u.fullName }}</strong><small>{{ u.roleLabel }}</small></div><span class="muted">{{ u.lastLoginAt|date('d/m/Y H:i') }}</span></div>
            {% else %}
                <p class="muted">Aucune connexion enregistrée.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
