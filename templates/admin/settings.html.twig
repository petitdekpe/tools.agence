{% extends 'admin/layout.html.twig' %}

{% block page_title %}Réglages du site{% endblock %}

{% block content %}
    <div class="panel form-panel">
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_row(form.headerTitle) }}
            {{ form_row(form.headerSubtitle) }}
            {% if setting.logoPath %}
                <div class="logo-preview"><img src="{{ asset('uploads/' ~ setting.logoPath) }}" alt="Logo actuel"></div>
                {{ form_row(form.removeLogo) }}
            {% else %}
                {% do form.removeLogo.setRendered %}
            {% endif %}
            {{ form_row(form.logo) }}
            <button class="btn" type="submit">Enregistrer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
