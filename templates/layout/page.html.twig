{% extends 'base.html.twig' %}

{# Page standard : grand titre, actions à droite, onglets facultatifs, messages flash, puis le contenu. #}

{% block title %}{% block page_title %}{% endblock %} · {{ site_settings().headerTitle }}{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ block('page_title') }}</h1>
        <div class="page-actions">{% block page_actions %}{% endblock %}</div>
    </div>

    {% block tabs %}{% endblock %}

    {% for type in ['success', 'warning', 'error'] %}
        {% for message in app.flashes(type) %}<div class="alert {{ type }}">{{ message }}</div>{% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
{% endblock %}
