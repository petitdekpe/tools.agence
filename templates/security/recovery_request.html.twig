{% extends 'base.html.twig' %}

{% block title %}Accès indisponible · {{ site_settings().headerTitle }}{% endblock %}
{% block body_class %}page-login{% endblock %}
{% block layout %}
<div class="login-wrap">
    <div class="login-card">
        {% include 'security/_brand.html.twig' %}
        <h1>Authentificateur indisponible</h1>
        {% if sent %}
            <div class="alert success">Si un compte correspond à cette adresse, un lien de récupération vient d'y être envoyé. Il est valable {{ minutes }} minutes.</div>
        {% else %}
            <p class="muted">Indiquez l'e-mail de votre compte : nous y enverrons un lien pour réinitialiser Google Authenticator.</p>
            <form method="post" class="form">
                {% if error %}<div class="alert error">{{ error }}</div>{% endif %}
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" autocomplete="username" required autofocus>
                <input type="hidden" name="_token" value="{{ csrf_token('recovery_request') }}">
                <button class="btn" type="submit">Envoyer le lien</button>
            </form>
        {% endif %}
        <p class="center"><a class="muted" href="{{ path('app_login') }}">← Retour à la connexion</a></p>
    </div>
</div>
{% endblock %}
