{% extends 'projet/layout.html.twig' %}
{% import 'projet/_macros.html.twig' as m %}

{% macro sort(key, label, filter, class = '') %}
    {% set dir = filter.sort == key and filter.dir == 'asc' ? 'desc' : 'asc' %}
    <th class="{{ class }}{{ filter.sort == key ? ' sorted' }}">
        <a href="{{ path('app_missions_list', filter.toQuery(false)|merge({sort: key, dir: dir})) }}">{{ label }}{% if filter.sort == key %} <span aria-hidden="true">{{ filter.dir == 'asc' ? '▲' : '▼' }}</span>{% endif %}</a>
    </th>
{% endmacro %}

{% block content %}
    {{ include('mission/_filters.html.twig', {action: 'app_missions_list', extra: {sort: filter.sort, dir: filter.dir}}) }}

    <div class="enc-toolbar">
        <span class="muted">{{ total }} mission{{ total > 1 ? 's' }}{% if filter.isActive %} (filtrée{{ total > 1 ? 's' }}){% endif %}{% if filter.from or filter.to %} · du {{ filter.from ? filter.from|date('d/m/Y') : '…' }} au {{ filter.to ? filter.to|date('d/m/Y') : '…' }}{% endif %}</span>
    </div>

    <div class="table-card">
        <table class="table enc-table">
            <thead>
                <tr>
                    {{ _self.sort('date', 'Dates', filter) }}
                    {{ _self.sort('titre', 'Mission', filter) }}
                    {{ _self.sort('lieu', 'Lieu', filter) }}
                    <th>Projet / client</th>
                    <th>Équipe</th>
                    {{ _self.sort('statut', 'Statut', filter) }}
                    <th class="right">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for mission in rows %}
                <tr class="{{ mission.statut == 'annulee' ? 'inactive' }}">
                    <td class="nowrap">{{ mission.dateDebut|date('d/m/Y') }}{% if mission.dateFin != mission.dateDebut %}<small class="block muted">au {{ mission.dateFin|date('d/m/Y') }}</small>{% endif %}</td>
                    <td><a href="{{ path('app_mission_show', {id: mission.id}) }}"><strong>{{ mission.titre }}</strong></a></td>
                    <td>{{ mission.lieu }}</td>
                    <td>{% if mission.projet %}<a href="{{ path('app_projet_show', {id: mission.projet.id}) }}">{{ mission.projet.nom }}</a>{% else %}—{% endif %}{% if mission.effectiveClient %}<small class="block muted">{{ mission.effectiveClient.name }}</small>{% endif %}</td>
                    <td>{{ mission.participants|length ? mission.participants|map(p => p.fullName)|join(', ') : '—' }}</td>
                    <td>{{ m.mission_state(mission) }}</td>
                    <td class="right"><a class="ghost" href="{{ path('app_mission_show', {id: mission.id}) }}">Ouvrir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="muted">Aucune mission{% if filter.isActive %} pour ces filtres{% endif %}.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages > 1 %}
        <nav class="pager">
            {% set q = filter.toQuery %}
            {% if page > 1 %}<a class="ghost" href="{{ path('app_missions_list', q|merge({page: page - 1})) }}">← Précédent</a>{% endif %}
            <span class="muted">Page {{ page }} / {{ pages }}</span>
            {% if page < pages %}<a class="ghost" href="{{ path('app_missions_list', q|merge({page: page + 1})) }}">Suivant →</a>{% endif %}
        </nav>
    {% endif %}
{% endblock %}
