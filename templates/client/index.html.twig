{% extends 'encaissement/layout.html.twig' %}

{% block page_title %}Clients{% endblock %}
{% block enc_actions %}<a class="btn" href="{{ path('app_client_new') }}">+ Nouveau client</a>{% endblock %}

{% block content %}
    <div class="table-card">
        <table class="table">
            <thead>
                <tr><th>Client</th><th>IFU</th><th>AIB appliqué</th><th class="right">Actions</th></tr>
            </thead>
            <tbody>
            {% for c in clients %}
                <tr>
                    <td><strong>{{ c.name }}</strong></td>
                    <td>{{ c.ifu ?: '—' }}</td>
                    <td>{% if c.hasIfu %}<span class="chip chip-ok">Taux avec IFU</span>{% else %}<span class="chip chip-warn">Taux sans IFU</span>{% endif %}</td>
                    <td class="right">
                        <div class="row-actions">
                            <a class="ghost" href="{{ path('app_encaissement_new', {client: c.id}) }}">+ Encaissement</a>
                            <a class="ghost" href="{{ path('app_client_edit', {id: c.id}) }}">Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="muted">Aucun client pour l'instant.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
