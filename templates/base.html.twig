<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        {% set site = site_settings() %}
        <title>{% block title %}{{ site.headerTitle }}{% endblock %}</title>
        {# Application installable (PWA) : manifeste, couleurs de la barre système et icône d'écran d'accueil iOS. #}
        <link rel="manifest" href="{{ path('app_manifest') }}">
        <meta name="theme-color" content="#ffffff">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="default">
        <meta name="apple-mobile-web-app-title" content="{{ site.headerTitle|slice(0, 12) }}">
        <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png">
        {# Fondu entre deux pages (Turbo) : la navigation ressemble à celle d'une application. #}
        <meta name="view-transition" content="same-origin">
        {# Filet de sécurité : si les assets compilés sont en retard sur les gabarits (asset-map:compile oublié), la barre d'onglets et
           la feuille « Créer » restent cachées au lieu de s'afficher sans style. :where() a une spécificité nulle : le vrai CSS l'emporte. #}
        <style>:where(.tabbar, .sheet, .topbar-title) { display: none; }</style>
        {# Le service worker s'enregistre sans attendre le JavaScript compilé (voir aussi pwa_controller.js, qui s'en sert ensuite). #}
        <script>if ('serviceWorker' in navigator) { addEventListener('load', function () { navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {}); }); }</script>
        {% if site.logoPath %}<link rel="icon" href="{{ asset('uploads/' ~ site.logoPath) }}">{% else %}<link rel="icon" type="image/png" href="/pwa/favicon-32.png">{% endif %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}" data-controller="pwa tables">
        {# Coque de l'application : barre du haut, menu latéral et panneau principal. Les pages sans menu (connexion) redéfinissent « layout ». #}
        {% block layout %}
            {% import '_icons.html.twig' as i %}
            {% set route = app.request.attributes.get('_route') %}
            {% set tools = nav_tools() %}

            {# Outil en cours (en-tête du menu) et actions de création accessibles à l'utilisateur. #}
            {% set context = {title: site.headerTitle, icon: 'home'} %}
            {% for tool in tools %}{% for prefix in tool.match %}{% if route starts with prefix %}{% set context = {title: tool.title, icon: tool.icon} %}{% endif %}{% endfor %}{% endfor %}
            {% if route starts with 'app_admin' %}{% set context = {title: 'Administration', icon: 'chart'} %}{% endif %}

            {% set create = [] %}
            {% if is_granted('correcteur.use') %}{% set create = create|merge([{label: 'Relire un texte', route: 'app_correcteur', icon: 'pen'}]) %}{% endif %}
            {% if is_granted('encaissement.edit') %}{% set create = create|merge([{label: 'Nouvel encaissement', route: 'app_encaissement_new', icon: 'cash'}, {label: 'Nouveau client', route: 'app_client_new', icon: 'user'}]) %}{% endif %}
            {% if is_granted('facture.edit') %}{% set create = create|merge([{label: 'Nouvelle facture', route: 'app_facture_new', icon: 'invoice', query: {type: 'facture'}}, {label: 'Nouveau devis', route: 'app_facture_new', icon: 'invoice', query: {type: 'devis'}}]) %}{% endif %}
            {% if is_granted('projet.edit') %}{% set create = create|merge([{label: 'Nouveau projet', route: 'app_projet_new', icon: 'kanban'}]) %}{% endif %}
            {% if is_granted('mission.plan') %}{% set create = create|merge([{label: 'Programmer une mission', route: 'app_mission_new', icon: 'pin'}]) %}{% endif %}
            {% if is_granted('calendrier.edit') %}{% set create = create|merge([{label: 'Planifier une publication', route: 'app_publication_new', icon: 'megaphone'}]) %}{% endif %}
            {% if is_granted('depense.edit') %}{% set create = create|merge([{label: 'Nouvelle dépense', route: 'app_depense_new', icon: 'wallet'}]) %}{% endif %}
            {% if is_granted('ticket.create') %}{% set create = create|merge([{label: 'Signaler une panne', route: 'app_ticket_new', icon: 'wrench', query: {type: 'panne'}}, {label: 'Demander du matériel', route: 'app_ticket_new', icon: 'wrench', query: {type: 'demande'}}]) %}{% endif %}
            {% if is_granted('absence.create') %}{% set create = create|merge([{label: 'Poser une absence', route: 'app_absence_new', icon: 'calendar'}]) %}{% endif %}
            {% if is_granted('personnel.edit') %}{% set create = create|merge([{label: 'Nouvelle fiche du personnel', route: 'app_personnel_new', icon: 'users'}]) %}{% endif %}
            {% if is_granted('materiel.edit') %}{% set create = create|merge([{label: 'Nouveau matériel', route: 'app_materiel_new', icon: 'laptop'}]) %}{% endif %}
            {% if is_granted('ROLE_ADMIN') %}{% set create = create|merge([{label: 'Nouvel utilisateur', route: 'app_admin_user_new', icon: 'key'}]) %}{% endif %}

            <div class="shell" data-controller="shell" data-action="click@window->shell#outside keydown.esc@window->shell#escape">
                <header class="topbar">
                    <a href="{{ path('app_home') }}" class="brand">
                        {% if site.logoPath %}
                            <img class="brand-logo" src="{{ asset('uploads/' ~ site.logoPath) }}" alt="">
                        {% else %}
                            <span class="brand-mark">{{ site.headerTitle|slice(0, 1)|upper }}</span>
                        {% endif %}
                        <span class="brand-text">{{ site.headerTitle }}</span>
                    </a>
                    {# Sur mobile, le titre de l'outil en cours remplace le nom du site (voir app.css). #}
                    <span class="topbar-title">{{ context.title }}</span>

                    {% if app.user %}
                        <div class="usermenu">
                            <button type="button" class="avatar-btn" data-shell-target="menuButton" data-action="shell#toggleMenu" aria-haspopup="true" aria-expanded="false" aria-label="Mon compte">{{ app.user.fullName|slice(0, 1)|upper }}</button>
                            <div class="menu" data-shell-target="menuPanel" hidden>
                                <a class="menu-head" href="{{ path('app_profile') }}" title="Voir mon profil">
                                    <span class="avatar-circle lg">{{ app.user.fullName|slice(0, 1)|upper }}</span>
                                    <div>
                                        <strong>{{ app.user.fullName }}</strong>
                                        <small>{{ app.user.email }}</small>
                                        <span class="role">{{ app.user.roleLabel }}</span>
                                    </div>
                                </a>
                                <a class="menu-item" href="{{ path('app_profile') }}">{{ i.icon('user', 18) }}<span>Mon profil</span></a>
                                <a class="menu-item" href="{{ path('app_home') }}">{{ i.icon('home', 18) }}<span>Accueil</span></a>
                                {% if is_granted('admin.access') %}
                                    <a class="menu-item" href="{{ path('app_admin') }}">{{ i.icon('dashboard', 18) }}<span>Administration</span></a>
                                {% endif %}
                                {{ include('_install_buttons.html.twig', {cls: 'menu-item', size: 18}) }}
                                <a class="menu-item" href="{{ path('app_logout') }}" data-action="pwa#logout">{{ i.icon('power', 18) }}<span>Déconnexion</span></a>
                            </div>
                        </div>
                    {% endif %}
                </header>

                <div class="shell-body">
                    <aside class="side" data-shell-target="side">
                        <div class="side-head">
                            <span class="side-ctx-icon">{{ i.icon(context.icon, 18) }}</span>
                            <strong>{{ context.title }}</strong>
                        </div>

                        {% if create %}
                            <div class="create">
                                <button type="button" class="pill-btn" data-shell-target="createButton" data-action="shell#toggleCreate" aria-haspopup="true" aria-expanded="false">{{ i.icon('plus', 16) }} Créer</button>
                                <div class="menu menu-left" data-shell-target="createPanel" hidden>
                                    {% for c in create %}
                                        <a class="menu-item" href="{{ path(c.route, c.query|default({})) }}">{{ i.icon(c.icon, 18) }}<span>{{ c.label }}</span></a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <nav class="nav" aria-label="Navigation principale">
                            <a class="nav-item {{ route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">{{ i.icon('home', 20) }}<span>Accueil</span></a>

                            {# Catégories du menu : Administration, puis RH et finance, Matériel, Stratégie. Une catégorie n'apparaît que si le rôle donne accès à l'un de ses outils. #}
                            {% if is_granted('admin.access') %}
                                <div class="nav-group adm-nav">
                                <span class="nav-label">Administration</span>
                                <a class="nav-item {{ route == 'app_admin' ? 'active' }}" href="{{ path('app_admin') }}">{{ i.icon('chart', 20) }}<span>Tableau de bord</span></a>
                                {% if is_granted('users.view') %}<a class="nav-item {{ route starts with 'app_admin_user' ? 'active' }}" href="{{ path('app_admin_users') }}">{{ i.icon('user', 20) }}<span>Utilisateurs</span></a>{% endif %}
                                {% if is_granted('ROLE_ADMIN') %}<a class="nav-item {{ route starts with 'app_admin_role' ? 'active' }}" href="{{ path('app_admin_roles') }}">{{ i.icon('key', 20) }}<span>Rôles</span></a>{% endif %}
                                {% if is_granted('activity.view') %}<a class="nav-item {{ route == 'app_admin_activity' ? 'active' }}" href="{{ path('app_admin_activity') }}">{{ i.icon('list', 20) }}<span>Journal d'activité</span></a>{% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a class="nav-item {{ route starts with 'app_admin_choice' ? 'active' }}" href="{{ path('app_admin_choices') }}">{{ i.icon('list', 20) }}<span>Listes de choix</span></a>
                                    <a class="nav-item {{ route == 'app_admin_settings' ? 'active' }}" href="{{ path('app_admin_settings') }}">{{ i.icon('sliders', 20) }}<span>Réglages du site</span></a>
                                    <a class="nav-item {{ route == 'app_admin_fiscal' ? 'active' }}" href="{{ path('app_admin_fiscal') }}">{{ i.icon('percent', 20) }}<span>Paramètres fiscaux</span></a>
                                {% endif %}
                                </div>
                            {% endif %}

                            {% for group in nav_groups() %}
                                <div class="nav-group nav-cat-{{ group.key }}">
                                    <span class="nav-label">{{ group.label }}</span>
                                    {% for tool in group.tools %}
                                        {% set on = false %}
                                        {% for prefix in tool.match %}{% if route starts with prefix %}{% set on = true %}{% endif %}{% endfor %}
                                        <a class="nav-item {{ on ? 'active' }}" href="{{ path(tool.route, tool.params|default({})) }}"{% if tool.external|default(false) %} target="_blank" rel="noopener"{% endif %}>
                                            {{ i.icon(tool.icon, 20) }}<span>{{ tool.title }}</span>
                                            {% if tool.external|default(false) %}<span class="nav-ext">{{ i.icon('external', 14) }}</span>{% endif %}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endfor %}

                            {# Raccourcis du compte, utiles surtout sur mobile où le menu latéral sert de menu principal. #}
                            {% if app.user %}
                                <div class="nav-group nav-account">
                                    <span class="nav-title">Mon compte</span>
                                    <a class="nav-item {{ route starts with 'app_profile' ? 'active' }}" href="{{ path('app_profile') }}">{{ i.icon('user', 20) }}<span>Mon profil</span></a>
                                    {{ include('_install_buttons.html.twig', {cls: 'nav-item', size: 20}) }}
                                    <a class="nav-item" href="{{ path('app_logout') }}" data-action="pwa#logout">{{ i.icon('power', 20) }}<span>Déconnexion</span></a>
                                </div>
                            {% endif %}
                        </nav>
                    </aside>
                    <div class="scrim" data-action="click->shell#closeNav"></div>

                    <main class="main{% block main_class %}{% endblock %}">
                        <div class="main-inner">
                            {% block body %}{% endblock %}
                        </div>
                        {% block footer %}
                            {% import '_icons.html.twig' as i %}
                            <footer class="main-foot">
                                <span>© {{ 'now'|date('Y') }} {{ site.headerTitle }}</span>
                                <a href="{{ path('app_home') }}">Accueil</a>
                                {% if is_granted('admin.access') %}<a href="{{ path('app_admin') }}">Administration</a>{% endif %}
                                <a class="btn-outline" href="{{ path('app_logout') }}" data-action="pwa#logout">{{ i.icon('power', 16) }} Déconnexion</a>
                            </footer>
                        {% endblock %}
                    </main>
                </div>

                {# Barre d'onglets du bas (mobile) : accueil, menu, création, profil. #}
                {% if app.user %}
                    <nav class="tabbar" aria-label="Navigation rapide">
                        <a class="tab {{ route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">{{ i.icon('home', 22) }}<span>Accueil</span></a>
                        <button type="button" class="tab" data-action="shell#toggleNav" aria-label="Ouvrir le menu">{{ i.icon('menu', 22) }}<span>Menu</span></button>
                        {% if create %}<button type="button" class="tab tab-create" data-action="shell#toggleSheet" aria-haspopup="dialog" aria-label="Créer">{{ i.icon('plus', 24) }}</button>{% endif %}
                        <a class="tab {{ route starts with 'app_profile' ? 'active' }}" href="{{ path('app_profile') }}">{{ i.icon('user', 22) }}<span>Profil</span></a>
                    </nav>
                    {% if create %}
                        <div class="sheet" data-shell-target="sheet" data-action="click->shell#closeSheetOutside" hidden>
                            <div class="sheet-panel" role="dialog" aria-label="Créer">
                                <span class="sheet-grip" aria-hidden="true"></span>
                                <strong class="sheet-title">Créer</strong>
                                {% for c in create %}
                                    <a class="sheet-item" href="{{ path(c.route, c.query|default({})) }}">{{ i.icon(c.icon, 20) }}<span>{{ c.label }}</span></a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                {# Hors ligne : on consulte les dernières pages vues, les modifications sont désactivées (voir pwa_controller.js). #}
                <div class="offline-banner" data-pwa-target="banner" role="status" hidden>Hors ligne : consultation seule. Les modifications reprendront dès le retour du réseau.</div>
            </div>
        {% endblock %}
    </body>
</html>
