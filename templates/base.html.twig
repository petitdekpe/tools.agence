<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% set site = site_settings() %}
        <title>{% block title %}{{ site.headerTitle }}{% endblock %}</title>
        {% if site.logoPath %}<link rel="icon" href="{{ asset('uploads/' ~ site.logoPath) }}">{% endif %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block header %}
        <header class="site-header">
            <a href="{{ path('app_home') }}" class="brand">
                {% if site.logoPath %}<img class="brand-logo" src="{{ asset('uploads/' ~ site.logoPath) }}" alt="">{% endif %}
                <span class="brand-text">
                    <strong>{{ site.headerTitle }}</strong>
                    {% if site.headerSubtitle %}<small>{{ site.headerSubtitle }}</small>{% endif %}
                </span>
            </a>
            {% if app.user %}
                <nav class="header-nav">
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_DIRECTION') %}
                        <a href="{{ path('app_admin') }}">Administration</a>
                    {% endif %}
                    <span class="header-user">{{ app.user.fullName }} <small>{{ app.user.roleLabel }}</small></span>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                </nav>
            {% endif %}
        </header>
        {% endblock %}
        <main class="container{% block main_class %}{% endblock %}">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
