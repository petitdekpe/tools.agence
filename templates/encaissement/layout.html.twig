{% extends 'layout/page.html.twig' %}

{% block page_title %}Suivi des encaissements{% endblock %}

{% block page_actions %}{% block enc_actions %}{% if is_granted('encaissement.edit') %}<a class="btn" href="{{ path('app_encaissement_new') }}">+ Nouvel encaissement</a>{% endif %}{% endblock %}{% endblock %}

{% block tabs %}
    {% set route = app.request.attributes.get('_route') %}
    <nav class="tabs">
        <a href="{{ path('app_encaissements') }}" class="{{ route in ['app_encaissements', 'app_encaissement_new', 'app_encaissement_edit'] ? 'active' }}">Encaissements</a>
        <a href="{{ path('app_encaissements_summary') }}" class="{{ route == 'app_encaissements_summary' ? 'active' }}">Synthèse</a>
        <a href="{{ path('app_clients') }}" class="{{ route starts with 'app_client' ? 'active' }}">Clients</a>
        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_fiscal') }}">Paramètres fiscaux</a>{% endif %}
    </nav>
{% endblock %}
